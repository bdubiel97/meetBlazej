---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import UnderConstruction from "../../components/UnderConstruction.astro";

const albums = await getCollection("photography");
---

<BaseLayout title="Photography">
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Photography" }]} />
  <h1>Photography</h1>
  <UnderConstruction />

  <div class="album-grid">
    {
      albums.map((album) => (
        <a class="album-tile retro-border retro-shadow" href={`/photography/${album.id}`}>
          <img src={album.data.coverImage} alt={album.data.title} loading="lazy" />
          <span class="album-title">{album.data.title}</span>
        </a>
      ))
    }
  </div>
</BaseLayout>

<style>
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .album-tile {
    background: var(--color-input-bg);
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
  }

  .album-tile img {
    aspect-ratio: 1;
    object-fit: cover;
    border-bottom: var(--border-width) solid var(--color-ink);
  }

  .album-title {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: -0.5px;
    padding: 0.85rem;
  }
</style>
