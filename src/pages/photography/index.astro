---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilmReel from "../../components/FilmReel.astro";
import AlbumGrid from "../../components/AlbumGrid.astro";
import site from "../../data/site.json";
import { sitePages } from "../../data/nav";

const albums = await getCollection("photography");
const pageLabel = sitePages.find((p) => p.id === "photography")!.label;
---

<BaseLayout title={pageLabel} theme="photography">
  <h1>{pageLabel}</h1>
  <nav class="header-links" aria-label="Photography links">
    <a href={site.photographyInstagram} target="_blank" rel="noopener noreferrer">
      Instagram
    </a>
  </nav>
  <FilmReel />

  <AlbumGrid albums={albums} />
</BaseLayout>

<style>
  /* Keep "Analog Playground" on a single line on phones: shrink the heading
     just enough to fit the screen width (17 characters), never above normal. */
  @media (max-width: 640px) {
    h1 {
      font-size: min(1.5rem, calc((100vw - 2.5rem) / 17.6));
    }
  }
</style>
