---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import AlbumGrid from "../../../components/AlbumGrid.astro";
import { groupAlbumsByEquipment } from "../../../utils/equipment";
import { sitePages } from "../../../data/nav";

export async function getStaticPaths() {
  const albums = await getCollection("photography");
  const groups = groupAlbumsByEquipment(albums, "film");
  return groups.map((group) => ({
    params: { film: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
const photographyLabel = sitePages.find((p) => p.id === "photography")!.label;
---

<BaseLayout title={group.label} theme="photography">
  <Breadcrumb
    items={[
      { label: photographyLabel, href: "/photography" },
      { label: "Films" },
      { label: group.label },
    ]}
  />
  <h1>{group.label}</h1>

  <AlbumGrid albums={group.albums} />
</BaseLayout>
