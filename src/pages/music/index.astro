---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MonkeyAnimation from "../../components/MonkeyAnimation.astro";
import RetroPanel from "../../components/RetroPanel.astro";
import EmbedPlayer from "../../components/EmbedPlayer.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import Lightbox from "../../components/Lightbox.astro";
import SoundPlayer from "../../components/SoundPlayer.astro";
import music from "../../data/music.json";
import site from "../../data/site.json";
import { getMusicBlocks } from "../../utils/musicBlocks";
import { gigPhotosSectionId, sitePages } from "../../data/nav";

const pageLabel = sitePages.find((p) => p.id === "music")!.label;
const blocks = getMusicBlocks();

// One shared Lightbox for every gig grid; each grid gets the index of its
// first photo within this flat list.
const galleryStarts = music.gigGalleries.map((_, i) =>
  music.gigGalleries.slice(0, i).reduce((sum, g) => sum + g.photos.length, 0)
);
const allGigPhotos = music.gigGalleries.flatMap((g) =>
  g.photos.map((p) => ({ src: p.src, alt: p.alt }))
);
---

<BaseLayout title={pageLabel} theme="music">
  <div class="page-header">
    <h1>{pageLabel}</h1>
    <nav class="header-links" aria-label="Personal music links">
      <a href={site.musicSoundcloud} target="_blank" rel="noopener noreferrer">
        SoundCloud
      </a>
      <a href={site.musicInstagram} target="_blank" rel="noopener noreferrer">
        Instagram
      </a>
    </nav>
  </div>
  {
    blocks.map((block) =>
      block.kind === "about" ? (
        <RetroPanel id="about" title="About">
          <p>{music.about}</p>
          <nav class="music-links" aria-label="Music links">
            <a href={site.musicSoundcloudIpa} target="_blank" rel="noopener noreferrer">
              SoundCloud IPA
            </a>
            <a href={site.musicInstagramIpa} target="_blank" rel="noopener noreferrer">
              Instagram IPA
            </a>
          </nav>
        </RetroPanel>
      ) : block.kind === "gigPhotos" ? (
        <RetroPanel id={gigPhotosSectionId}>
          <div class="gig-galleries">
            {music.gigGalleries.map((gallery, i) => <PhotoGrid {...gallery} startIndex={galleryStarts[i]} />)}
          </div>
        </RetroPanel>
      ) : (
        <RetroPanel id={block.set.id} title={block.set.title}>
          {block.set.description && <p>{block.set.description}</p>}
          <EmbedPlayer platform={block.set.platform} url={block.set.url} title={block.set.title} />
        </RetroPanel>
      )
    )
  }

  <Lightbox photos={allGigPhotos} showGrid={false} />

  <SoundPlayer />

  <MonkeyAnimation />
</BaseLayout>

<style>
  /* Heading and the personal links share one line, links flush right. */
  .page-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .page-header h1 {
    --h1-size: 1.5rem;
    font-size: var(--h1-size);
    margin: 0;
    min-width: 0;
  }

  .page-header .header-links {
    /* The pixel font's letters sit a little above its reported baseline, so
       plain baseline alignment leaves the links ~0.11em too low. */
    position: relative;
    top: calc(var(--h1-size, 1.5rem) * -0.11);
    margin: 0 0 0 auto;
    gap: 0.6rem;
    flex-wrap: nowrap;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  /* On phones the heading shrinks a little so both links always fit beside it. */
  @media (max-width: 640px) {
    .page-header h1 {
      --h1-size: 1.2rem;
    }

    .page-header .header-links {
      --h1-size: 1.2rem;
    }
  }

  .music-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* The theme's regular link color matches this panel's background
     exactly, so links inside a panel need the panel-ink color instead
     to stay visible. */
  .music-links a {
    color: var(--color-panel-ink);
  }

  .gig-galleries {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
