---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MonkeyAnimation from "../../components/MonkeyAnimation.astro";
import RetroPanel from "../../components/RetroPanel.astro";
import EmbedPlayer from "../../components/EmbedPlayer.astro";
import music from "../../data/music.json";
import site from "../../data/site.json";
import { slugify } from "../../utils/slugify";
import { gigPhotosSectionId, sitePages } from "../../data/nav";

const pageLabel = sitePages.find((p) => p.id === "music")!.label;
---

<BaseLayout title={pageLabel} theme="music">
  <h1>{pageLabel}</h1>
  <RetroPanel id="about" title="About">
    <p>{music.about}</p>
    <nav class="music-links" aria-label="Music links">
      <a href={site.musicSoundcloud} target="_blank" rel="noopener noreferrer">
        SoundCloud
      </a>
      <a href={site.musicInstagram} target="_blank" rel="noopener noreferrer">
        Instagram
      </a>
      <a href={site.musicSoundcloudIpa} target="_blank" rel="noopener noreferrer">
        SoundCloud IPA
      </a>
      <a href={site.musicInstagramIpa} target="_blank" rel="noopener noreferrer">
        Instagram IPA
      </a>
    </nav>
  </RetroPanel>

  {
    music.sets.map((set, i) => (
      <RetroPanel id={`${slugify(set.title)}-${i}`} title={set.title}>
        {set.description && <p>{set.description}</p>}
        <EmbedPlayer platform={set.platform} url={set.url} title={set.title} />
      </RetroPanel>
    ))
  }

  <RetroPanel id={gigPhotosSectionId} title="gig-photos.dir">
    <div class="gig-grid">
      {
        music.gigPhotos.map((photo) => (
          <figure class="gig-figure retro-border retro-shadow">
            <img src={photo.src} alt={photo.alt} loading="lazy" />
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </RetroPanel>

  <MonkeyAnimation />
</BaseLayout>

<style>
  .music-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* The theme's regular link color matches this panel's background
     exactly, so links inside a panel need the panel-ink color instead
     to stay visible. */
  .music-links a {
    color: var(--color-panel-ink);
  }

  .gig-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }

  .gig-figure {
    margin: 0;
    background: var(--color-input-bg);
  }

  .gig-figure img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gig-figure figcaption {
    padding: 0.5rem;
    font-size: 0.85rem;
    text-align: center;
  }
</style>
