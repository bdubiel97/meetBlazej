---
import BaseLayout from "../layouts/BaseLayout.astro";
import RetroPanel from "../components/RetroPanel.astro";
import cv from "../data/cv.json";
import { homeSections } from "../data/nav";

// Look up a section's title from the shared list in src/data/nav.ts, so the
// MENU dropdown and the panel headings never drift out of sync.
function sectionTitle(id: string) {
  return homeSections.find((section) => section.id === id)?.label ?? id;
}
---

<BaseLayout title="CV">
  <div class="profile-header">
    <img class="profile-photo retro-border retro-shadow" src={cv.photo} alt={cv.name} />
    <div>
      <h1>{cv.name}</h1>
      <p class="profile-title">{cv.title}</p>
      <p class="profile-location">{cv.contact.location}</p>
      <nav class="header-links" aria-label="Profile links">
        {
          cv.contact.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <RetroPanel id="about-txt" title={sectionTitle("about-txt")}>
    <p>{cv.summary}</p>
  </RetroPanel>

  <RetroPanel id="experience-exe" title={sectionTitle("experience-exe")}>
    {
      cv.experience.map((job) => (
        <div class="entry">
          <h3>
            {job.role} — {job.company}
          </h3>
          <p class="entry-dates">
            {job.start} – {job.end}
            {job.place && ` · ${job.place}`}
          </p>
          <ul>
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          {job.stack && (
            <p class="entry-stack">
              <strong>{job.stack.join(", ")}</strong>
            </p>
          )}
        </div>
      ))
    }
  </RetroPanel>

  <RetroPanel id="education-dat" title={sectionTitle("education-dat")}>
    {
      cv.education.map((edu) => (
        <div class="entry">
          <h3>
            {edu.degree} — {edu.school}
          </h3>
          <p class="entry-dates">
            {edu.start} – {edu.end}
          </p>
          {edu.notes && <p>{edu.notes}</p>}
        </div>
      ))
    }
  </RetroPanel>

  <RetroPanel id="courses-log" title={sectionTitle("courses-log")}>
    {
      cv.coursesConferences.map((course) => (
        <div class="entry">
          <h3>{course.name}</h3>
          <p class="entry-dates">
            {course.provider && `${course.provider} — `}{course.date}
          </p>
          {course.notes && <p>{course.notes}</p>}
        </div>
      ))
    }
  </RetroPanel>

  <RetroPanel id="projects-zip" title={sectionTitle("projects-zip")}>
    <ul>
      {cv.projects.map((project) => <li>{project}</li>)}
    </ul>
  </RetroPanel>

  <RetroPanel id="skills-sys" title={sectionTitle("skills-sys")}>
    {
      cv.skills.map((group) => (
        <div class="skill-group">
          <h3>{group.category}</h3>
          <p>{group.items.join(", ")}</p>
        </div>
      ))
    }
  </RetroPanel>

  <RetroPanel id="contact-cfg" title={sectionTitle("contact-cfg")}>
    <p>Email: <a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a></p>
    {cv.contact.phone && (
      <p>Phone: <a href={`tel:${cv.contact.phone.replace(/\s+/g, "")}`}>{cv.contact.phone}</a></p>
    )}
    <ul class="contact-links">
      {
        cv.contact.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </RetroPanel>
</BaseLayout>

<style>
  .profile-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .profile-photo {
    width: 140px;
    height: auto;
    filter: grayscale(1) contrast(1.05);
  }

  .profile-title,
  .profile-location {
    margin: 0 0 0.4rem;
  }

  .entry {
    margin-bottom: 1.25rem;
  }

  .entry:last-child {
    margin-bottom: 0;
  }

  .entry-dates {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .entry-stack {
    margin: 0.75rem 0 0;
    padding-left: 40px;
  }

  .skill-group {
    margin-bottom: 1rem;
  }

  .skill-group:last-child {
    margin-bottom: 0;
  }

  .contact-links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
