---
import BaseLayout from "../layouts/BaseLayout.astro";
import RetroPanel from "../components/RetroPanel.astro";
import cv from "../data/cv.json";
---

<BaseLayout title="CV">
  <div class="profile-header">
    <img class="profile-photo retro-border" src={cv.photo} alt={cv.name} />
    <div>
      <h1>{cv.name}</h1>
      <p class="profile-title">{cv.title}</p>
      <p class="profile-location">{cv.contact.location}</p>
    </div>
  </div>

  <RetroPanel title="about.txt">
    <p>{cv.summary}</p>
  </RetroPanel>

  <RetroPanel title="experience.exe">
    {
      cv.experience.map((job) => (
        <div class="entry">
          <h3>
            {job.role} — {job.company}
          </h3>
          <p class="entry-dates">
            {job.start} – {job.end}
          </p>
          <ul>
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </RetroPanel>

  <RetroPanel title="education.dat">
    {
      cv.education.map((edu) => (
        <div class="entry">
          <h3>
            {edu.degree} — {edu.school}
          </h3>
          <p class="entry-dates">
            {edu.start} – {edu.end}
          </p>
          {edu.notes && <p>{edu.notes}</p>}
        </div>
      ))
    }
  </RetroPanel>

  <RetroPanel title="skills.sys">
    {
      cv.skills.map((group) => (
        <div class="skill-group">
          <h3>{group.category}</h3>
          <p>{group.items.join(", ")}</p>
        </div>
      ))
    }
  </RetroPanel>

  <RetroPanel title="contact.cfg">
    <p>Email: <a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a></p>
    <ul class="contact-links">
      {
        cv.contact.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </RetroPanel>
</BaseLayout>

<style>
  .profile-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .profile-photo {
    width: 140px;
    height: 175px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .profile-title,
  .profile-location {
    margin: 0 0 0.4rem;
  }

  .entry {
    margin-bottom: 1.25rem;
  }

  .entry:last-child {
    margin-bottom: 0;
  }

  .entry-dates {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .skill-group {
    margin-bottom: 1rem;
  }

  .skill-group:last-child {
    margin-bottom: 0;
  }

  .contact-links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
