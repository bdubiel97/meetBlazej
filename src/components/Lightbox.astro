---
interface Photo {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="photo-grid" data-lightbox-root>
  {
    photos.map((photo, i) => (
      <button type="button" class="photo-thumb retro-border retro-shadow" data-open-lightbox={i}>
        <img src={photo.src} alt={photo.alt} loading="lazy" />
      </button>
    ))
  }
</div>

<div class="lightbox-overlay" data-lightbox-overlay hidden>
  <div class="lightbox-inner retro-border retro-shadow">
    <button type="button" class="retro-btn lightbox-close" data-lightbox-close>CLOSE [X]</button>
    <img data-lightbox-image src="" alt="" />
    <p data-lightbox-caption class="lightbox-caption"></p>
    <div class="lightbox-nav">
      <button type="button" class="retro-btn" data-lightbox-prev>&larr; PREV</button>
      <button type="button" class="retro-btn" data-lightbox-next>NEXT &rarr;</button>
    </div>
  </div>
</div>

<script type="module" define:vars={{ photosJson: JSON.stringify(photos) }}>
  const photos = JSON.parse(photosJson);
  const overlay = document.querySelector("[data-lightbox-overlay]");
  const imageEl = document.querySelector("[data-lightbox-image]");
  const captionEl = document.querySelector("[data-lightbox-caption]");
  const closeBtn = document.querySelector("[data-lightbox-close]");
  const prevBtn = document.querySelector("[data-lightbox-prev]");
  const nextBtn = document.querySelector("[data-lightbox-next]");
  const triggers = document.querySelectorAll("[data-open-lightbox]");

  let currentIndex = 0;
  let lastFocused = null;

  function render() {
    const photo = photos[currentIndex];
    if (!photo || !imageEl || !captionEl) return;
    imageEl.src = photo.src;
    imageEl.alt = photo.alt ?? "";
    captionEl.textContent = photo.caption ?? "";
  }

  function open(index) {
    currentIndex = index;
    lastFocused = document.activeElement;
    render();
    if (overlay) overlay.hidden = false;
    closeBtn?.focus();
    document.addEventListener("keydown", onKeydown);
  }

  function close() {
    if (overlay) overlay.hidden = true;
    document.removeEventListener("keydown", onKeydown);
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
  }

  function next() {
    currentIndex = (currentIndex + 1) % photos.length;
    render();
  }

  function prev() {
    currentIndex = (currentIndex - 1 + photos.length) % photos.length;
    render();
  }

  function onKeydown(e) {
    if (e.key === "Escape") close();
    if (e.key === "ArrowRight") next();
    if (e.key === "ArrowLeft") prev();
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const index = Number(trigger.getAttribute("data-open-lightbox"));
      open(index);
    });
  });

  closeBtn?.addEventListener("click", close);
  nextBtn?.addEventListener("click", next);
  prevBtn?.addEventListener("click", prev);

  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) close();
  });
</script>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }

  .photo-thumb {
    padding: 0;
    background: var(--color-input-bg);
    cursor: url("/cursors/pointer.svg") 4 1, pointer;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .photo-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(16, 16, 16, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    padding: 1.5rem;
  }

  .lightbox-overlay[hidden] {
    display: none;
  }

  .lightbox-inner {
    background: var(--color-bg);
    max-width: min(90vw, 720px);
    max-height: 90vh;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lightbox-inner img {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    margin: 0 auto;
  }

  .lightbox-caption {
    margin: 0;
    text-align: center;
  }

  .lightbox-nav {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .lightbox-close {
    align-self: flex-end;
  }
</style>
