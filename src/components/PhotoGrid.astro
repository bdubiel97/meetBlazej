---
import { photoUrl } from "../utils/photoUrl";

interface GridPhoto {
  src: string;
  alt: string;
  cols?: number;
  rows?: number;
}

interface Props {
  rows: number;
  cols: number;
  // Shape of ONE grid slot as "width/height" (default portrait 2/3). A photo
  // spanning several slots simply covers that many slots' worth of space.
  cellRatio?: string;
  photos: GridPhoto[];
}

const { rows, cols, cellRatio = "2/3", photos } = Astro.props;

const [cellW, cellH] = cellRatio.split("/").map(Number);
if (!(cellW > 0 && cellH > 0)) {
  throw new Error(`PhotoGrid: invalid cellRatio "${cellRatio}" (expected e.g. "2/3")`);
}

const usedSlots = photos.reduce((sum, p) => sum + (p.cols ?? 1) * (p.rows ?? 1), 0);
if (usedSlots > rows * cols) {
  throw new Error(
    `PhotoGrid: photos need ${usedSlots} slots but a ${rows}x${cols} grid only has ${rows * cols}.`
  );
}

const gridAspect = (cols * cellW) / (rows * cellH);
---

<div
  class="photo-grid"
  style={`--grid-cols:${cols}; --grid-rows:${rows}; aspect-ratio:${gridAspect};`}
>
  {
    photos.map((photo) => (
      <figure
        class="photo-cell retro-border retro-shadow"
        style={`grid-column: span ${photo.cols ?? 1}; grid-row: span ${photo.rows ?? 1};`}
      >
        <img src={photoUrl(photo.src, "full")} alt={photo.alt} loading="lazy" />
      </figure>
    ))
  }
</div>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), 1fr);
    grid-template-rows: repeat(var(--grid-rows), 1fr);
    gap: 1rem;
  }

  .photo-cell {
    margin: 0;
    min-width: 0;
    min-height: 0;
    background: var(--color-input-bg);
  }

  .photo-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
