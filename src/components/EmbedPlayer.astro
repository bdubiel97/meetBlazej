---
interface Props {
  platform: "youtube";
  url: string;
  title: string;
}

const { platform, url, title } = Astro.props;

function getYouTubeEmbedSrc(rawUrl: string): string | null {
  try {
    const parsed = new URL(rawUrl);
    let videoId: string | null = null;

    if (parsed.hostname.includes("youtu.be")) {
      videoId = parsed.pathname.slice(1);
    } else if (parsed.pathname.startsWith("/embed/")) {
      videoId = parsed.pathname.replace("/embed/", "");
    } else {
      videoId = parsed.searchParams.get("v");
    }

    if (!videoId) return null;
    return `https://www.youtube.com/embed/${videoId}`;
  } catch {
    return null;
  }
}

const embedSrc = getYouTubeEmbedSrc(url);
const aspectRatio = "56.25%";
---

{
  embedSrc ? (
    <div class="embed-wrap">
      <div class="ratio-box" style={`padding-bottom: ${aspectRatio}`}>
        <iframe
          src={embedSrc}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    </div>
  ) : (
    <p class="embed-error">Could not read a video ID from this URL — check src/data/music.json.</p>
  )
}

<style>
  .embed-wrap {
    border: var(--border-width) solid var(--color-ink);
    background: var(--color-input-bg);
  }

  .ratio-box {
    position: relative;
    height: 0;
  }

  .ratio-box iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .embed-error {
    font-family: var(--font-mono);
    padding: 1rem;
  }
</style>
