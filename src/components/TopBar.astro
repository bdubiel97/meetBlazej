---
import { getCollection } from "astro:content";
import music from "../data/music.json";
import { homeSections, gigPhotosSectionId, sitePages } from "../data/nav";
import { slugify } from "../utils/slugify";
import { groupAlbumsByEquipment } from "../utils/equipment";
import { sortAlbums } from "../utils/albums";

const pathname = Astro.url.pathname;
const section = pathname.startsWith("/photography")
  ? "photography"
  : pathname.startsWith("/music")
    ? "music"
    : "home";

interface MenuLink {
  label: string;
  href: string;
}

interface MenuGroup {
  label: string;
  children: MenuLink[];
}

type MenuItem = MenuLink | MenuGroup;

function isGroup(item: MenuItem): item is MenuGroup {
  return "children" in item;
}

let sectionLabel = sitePages.find((p) => p.id === section)!.label;
let sectionItems: MenuItem[] = [];

if (section === "home") {
  sectionItems = [
    { label: "Home", href: "/" },
    ...homeSections.map((s) => ({ label: s.label, href: `/#${s.id}` })),
  ];
} else if (section === "photography") {
  const albums = sortAlbums(await getCollection("photography"));
  sectionItems = [
    { label: "Home", href: "/photography" },
    {
      label: "Albums",
      children: albums.map((album) => ({
        label: album.data.title,
        href: `/photography/${album.id}`,
      })),
    },
    {
      label: "Cameras",
      children: groupAlbumsByEquipment(albums, "camera").map((group) => ({
        label: group.label,
        href: `/photography/cameras/${group.slug}`,
      })),
    },
    {
      label: "Films",
      children: groupAlbumsByEquipment(albums, "film").map((group) => ({
        label: group.label,
        href: `/photography/films/${group.slug}`,
      })),
    },
    {
      label: "Lenses",
      children: groupAlbumsByEquipment(albums, "lens").map((group) => ({
        label: group.label,
        href: `/photography/lenses/${group.slug}`,
      })),
    },
  ];
} else {
  const youtubeLinks = music.sets
    .map((set, i) => ({ ...set, id: `${slugify(set.title)}-${i}` }))
    .filter((set) => set.platform === "youtube");
  const otherLinks = music.sets
    .map((set, i) => ({ ...set, id: `${slugify(set.title)}-${i}` }))
    .filter((set) => set.platform !== "youtube");
  sectionItems = [
    { label: "Home", href: "/music" },
    { label: "About", href: "/music#about" },
    ...otherLinks.map((set) => ({ label: set.title, href: `/music#${set.id}` })),
    {
      label: "YouTube Sets",
      children: youtubeLinks.map((set) => ({
        label: set.title,
        href: `/music#${set.id}`,
      })),
    },
    { label: "gig-photos.dir", href: `/music#${gigPhotosSectionId}` },
  ];
}
---

<header class="top-bar retro-border" data-top-bar>
  <div class="top-bar-row container">
    <button
      type="button"
      class="retro-btn menu-toggle"
      aria-expanded="false"
      aria-controls="menu-dropdown"
      data-menu-toggle
    >
      MENU
    </button>
    <button type="button" class="retro-btn" data-open-contact>CONNECT</button>

    <div id="menu-dropdown" class="menu-dropdown retro-border retro-shadow" data-menu-dropdown hidden>
      <div class="menu-section-label">{sectionLabel}</div>
      <ul>
        {
          sectionItems.map((item) =>
            isGroup(item) ? (
              <li>
                <details class="menu-group">
                  <summary>{item.label}</summary>
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            )
          )
        }
      </ul>
    </div>
  </div>
</header>

<style>
  .top-bar {
    background: var(--color-bg);
    border-left: none;
    border-right: none;
    border-top: none;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .top-bar-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.75rem 1.5rem;
    position: relative;
  }

  .menu-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    background: var(--color-bg);
    width: min(320px, calc(100vw - 2.5rem));
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    z-index: 25;
  }

  .menu-dropdown[hidden] {
    display: none;
  }

  .menu-section-label {
    padding: 0.75rem 1rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: -0.5px;
    border-bottom: var(--border-width) solid var(--color-ink);
    /* Labels are stored in normal case in src/data/nav.ts; this keeps the
       existing all-caps retro look without hardcoding the case in markup. */
    text-transform: uppercase;
  }

  .menu-dropdown ul {
    list-style: none;
    margin: 0;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .menu-dropdown a {
    text-decoration: underline;
  }

  .menu-group summary {
    cursor: pointer;
    list-style: none;
    font-family: inherit;
    font-size: inherit;
  }

  .menu-group summary::-webkit-details-marker {
    display: none;
  }

  .menu-group summary::before {
    content: "[+] ";
  }

  .menu-group[open] summary::before {
    content: "[-] ";
  }

  .menu-group ul {
    padding: 0.6rem 0 0 1.5rem;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const dropdown = document.querySelector<HTMLElement>("[data-menu-dropdown]");

  function openMenu() {
    if (!dropdown || !toggle) return;
    dropdown.hidden = false;
    toggle.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    if (!dropdown || !toggle) return;
    dropdown.hidden = true;
    toggle.setAttribute("aria-expanded", "false");
  }

  function toggleMenu() {
    if (!dropdown) return;
    dropdown.hidden ? openMenu() : closeMenu();
  }

  toggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    toggleMenu();
  });

  dropdown?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") closeMenu();
  });

  document.addEventListener("click", (e) => {
    if (!dropdown || dropdown.hidden) return;
    const target = e.target as Node;
    if (!dropdown.contains(target) && target !== toggle) closeMenu();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
