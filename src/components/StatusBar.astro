---
import { sitePages } from "../data/nav";
import cameraIcon from "../assets/icons/camera.svg?raw";
import tuneIcon from "../assets/icons/tune.svg?raw";

const icons = { camera: cameraIcon, tune: tuneIcon };
---

<footer class="status-bar retro-border" data-status-bar>
  <div class="status-bar-row container">
    <span data-visitor-no>VISITOR:----</span>
    <nav class="status-nav" aria-label="Primary">
      {
        sitePages.map((page) => (
          <a class="retro-btn" href={page.href} aria-label={page.label}>
            <span class="label-full">{page.label}</span>
            {"text" in page.mobile ? (
              <span class="label-short" aria-hidden="true">{page.mobile.text}</span>
            ) : (
              <span
                class={`label-short icon icon-${page.mobile.icon}`}
                aria-hidden="true"
                set:html={icons[page.mobile.icon]}
              />
            )}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .status-bar {
    background: var(--color-bg);
    border-left: none;
    border-right: none;
    border-bottom: none;
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: -0.5px;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 20;
  }

  .status-bar-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.85rem 1.5rem;
    flex-wrap: wrap;
  }

  .status-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-left: auto;
  }

  /* Labels are stored in normal case in src/data/nav.ts; this keeps the
     existing all-caps retro look without hardcoding the case in markup. */
  .status-nav .retro-btn {
    text-transform: uppercase;
  }

  .label-short {
    display: none;
  }

  /* Phones: replace the long labels with "CV" and two small pixel icons so
     the three buttons stay on one row, all the same height. */
  @media (max-width: 640px) {
    .status-nav {
      gap: 0.75rem;
    }

    .status-nav .retro-btn {
      height: 36px;
      padding: 0 0.9em;
    }

    .label-full {
      display: none;
    }

    .label-short {
      display: inline-flex;
      align-items: center;
    }

    .label-short.icon :global(svg) {
      display: block;
      height: 18px;
      width: auto;
    }

    .label-short.icon-camera :global(svg) {
      aspect-ratio: 15 / 12;
    }

    .label-short.icon-tune :global(svg) {
      aspect-ratio: 1 / 1;
    }
  }
</style>

<script>
  const STORAGE_KEY = "site-visitor-no";

  function getVisitorNumber(): number {
    const stored = window.localStorage.getItem(STORAGE_KEY);
    if (stored) return Number(stored);
    const assigned = 1000 + Math.floor(Math.random() * 8999);
    window.localStorage.setItem(STORAGE_KEY, String(assigned));
    return assigned;
  }

  const visitorEl = document.querySelector("[data-visitor-no]");
  if (visitorEl) {
    try {
      visitorEl.textContent = `VISITOR:${getVisitorNumber()}`;
    } catch {
      visitorEl.textContent = "VISITOR:0001";
    }
  }
</script>
