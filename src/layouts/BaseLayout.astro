---
import "../styles/global.css";
import TopBar from "../components/TopBar.astro";
import StatusBar from "../components/StatusBar.astro";
import CursorTrail from "../components/CursorTrail.astro";
import ContactModal from "../components/ContactModal.astro";
import siteData from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  theme?: string;
}

const { title, description = siteData.tagline, theme } = Astro.props;
const pageTitle = title ? `${title} — ${siteData.siteTitle}` : siteData.siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body class={theme ? `theme-${theme}` : undefined}>
    <TopBar />
    <main class="container page-main">
      <slot />
    </main>
    <StatusBar />
    <CursorTrail />
    <ContactModal />
  </body>
</html>

<style>
  .page-main {
    padding-block: 2rem 6rem;
    min-height: 60vh;
  }
</style>
