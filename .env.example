# Copy this file to .env and fill in your own values.
# Used only by `npm run new-album` (scripts/new-album.mjs) — never read by
# the deployed site itself.

# Cloudflare dashboard -> Manage Account -> Account Home (shown in the URL
# and on the overview page).
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare dashboard -> My Profile -> API Tokens -> Create Token, scoped
# to "Cloudflare Images: Edit".
CLOUDFLARE_API_TOKEN=
